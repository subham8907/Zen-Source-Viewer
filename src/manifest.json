{
    "name": "Zen Source Viewer",
    "author": "Subham Mahesh",
    "description": "A calm, minimal viewer for the source code of Firefox and Thunderbird add-ons (XPI). Based on Extension source viewer by Rob Wu.",
    "version": "3.0.0",
    "manifest_version": 2,
    "browser_specific_settings": {
        "gecko": {
            "strict_min_version": "115.0",
            "id": "zen-source-viewer-official@subhammahesh",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "background": {
        "scripts": [
            "consent-state.js",
            "addon-urls.js",
            "background.js",
            "bg-contextmenu.js"
        ],
        "persistent": false
    },
    "browser_action": {
        "default_icon": {
            "16": "icons/16.png",
            "19": "icons/19.png",
            "32": "icons/32.png",
            "38": "icons/38.png"
        },
        "default_title": "Zen Source Viewer",
        "default_popup": "popup.html",
        "default_area": "navbar"
    },
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "options_ui": {
        "page": "options.html#optionsV2"
    },
    "permissions": [
        "tabs",
        "storage",
        "contextMenus",
        "downloads",
        "cookies",
        "webRequest",
        "webRequestBlocking",
        "*://*/*"
    ]
}
